        "category": "TypeScript Structure",
        "icon": "$(arrow-right)"
      },
      {
        "command": "tsStructure.report.filter",
        "title": "Filter Analysis Results…",
        "category": "TypeScript Structure",
        "icon": "$(filter)"
      },
      {
        "command": "tsStructure.report.next",
        "title": "Go to Next Result",
        "category": "TypeScript Structure",
        "icon": "$(arrow-down)"
      },
      {
        "command": "tsStructure.report.previous",
        "title": "Go to Previous Result",
        "category": "TypeScript Structure",
        "icon": "$(arrow-up)"
      },
      {
        "command": "tsStructure.report.copyMarkdown",
        "title": "Copy Analysis as Markdown",
        "category": "TypeScript Structure",
        "icon": "$(copy)"
      },
      {
        "command": "tsStructure.report.export",
        "title": "Export Analysis to Markdown…",
        "category": "TypeScript Structure",
        "icon": "$(save)"
      },
      {
        "command": "tsStructure.report.openToSide",
        "title": "Open to the Side",
        "category": "TypeScript Structure",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "tsStructure.report.copyLocation",
        "title": "Copy Location",
        "category": "TypeScript Structure"
      },
      {
        "command": "tsStructure.inspectCode",
        "title": "Inspect Code…",
        "category": "TypeScript Structure",
        "icon": "$(checklist)"
      },
      {
        "command": "tsStructure.report.applyFix",
        "title": "Apply Fix",
        "category": "TypeScript Structure",
        "icon": "$(lightbulb-autofix)"
