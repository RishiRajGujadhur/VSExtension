        "category": "TypeScript Structure"
      },
      {
        "command": "tsStructure.openLocation",
        "title": "Open Location",
        "category": "TypeScript Structure"
      },
      {
        "command": "tsStructure.rerunAnalysis",
        "title": "Re-run Analysis",
        "category": "TypeScript Structure",
        "icon": "$(refresh)"
      },
      {
        "command": "tsStructure.clearReport",
        "title": "Clear Analysis",
        "category": "TypeScript Structure",
        "icon": "$(clear-all)"
      },
      {
        "command": "tsStructure.dataFlow",
        "title": "Data Flow Path Explorer",
        "category": "TypeScript Structure"
      },
      {
        "command": "tsStructure.mutationTracking",
        "title": "Mutation Tracking (Active File)",
