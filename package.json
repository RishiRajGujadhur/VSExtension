{
  "name": "ts-test-impact",
  "displayName": "TypeScript Structure: Refactoring & Test Impact",
  "description": "WebStorm-style refactorings for TypeScript and JavaScript (Change Signature, Safe Delete, intention actions and more) plus test impact analysis. Deterministic, offline, no AI.",
  "version": "0.4.0",
  "publisher": "RishiRajGujadhur",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RishiRajGujadhur/VSExtension.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "refactoring",
    "change signature",
    "typescript",
    "react",
    "webstorm",
    "test impact"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tsImpact.analyze",
        "title": "Test Impact Analysis",
        "category": "TypeScript Structure",
        "icon": "$(search)"
      },
      {
        "command": "tsImpact.showLastResults",
        "title": "Show Last Impact Results",
        "category": "TypeScript Structure",
        "icon": "$(list-filter)"
      },
      {
        "command": "tsImpact.runImpactedTests",
        "title": "Run Impacted Tests",
        "category": "TypeScript Structure",
        "icon": "$(play)"
      },
      {
        "command": "tsImpact.runTest",
        "title": "Run Test",
        "category": "TypeScript Structure",
        "icon": "$(play)"
      },
      {
        "command": "tsImpact.clear",
        "title": "Clear Impact Results",
        "category": "TypeScript Structure",
        "icon": "$(clear-all)"
      },
      {
        "command": "tsStructure.changeSignature",
        "title": "Change Signature…",
        "category": "TypeScript Structure"
      },
      {
        "command": "tsStructure.safeDelete",
        "title": "Safe Delete…",
        "category": "TypeScript Structure"
      },
      {
        "command": "tsStructure.safeDeleteFile",
        "title": "Safe Delete File…",
        "category": "TypeScript Structure"
      }
    ],
    "submenus": [
      {
        "id": "tsStructure.editorMenu",
        "label": "TypeScript Structure"
      }
    ],
    "keybindings": [
      {
        "command": "tsStructure.changeSignature",
        "key": "ctrl+f6",
        "mac": "cmd+f6",
        "when": "editorTextFocus && editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact)$/"
      },
      {
        "command": "tsStructure.safeDelete",
        "key": "alt+delete",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact)$/"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "tsStructure.editorMenu",
          "when": "editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact)$/",
          "group": "1_modification@90"
        }
      ],
      "tsStructure.editorMenu": [
        {
          "command": "tsStructure.changeSignature",
          "group": "1_refactor@1"
        },
        {
          "command": "tsStructure.safeDelete",
          "group": "1_refactor@2"
        },
        {
          "command": "tsImpact.analyze",
          "group": "3_analysis@1"
        }
      ],
      "explorer/context": [
        {
          "command": "tsStructure.safeDeleteFile",
          "when": "resourceExtname =~ /^\\.[cm]?[jt]sx?$/",
          "group": "7_modification@90"
        }
      ],
      "commandPalette": [
        {
          "command": "tsImpact.runTest",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "tsImpact.analyze",
          "when": "view == tsImpact.results",
          "group": "navigation@1"
        },
        {
          "command": "tsImpact.runImpactedTests",
          "when": "view == tsImpact.results",
          "group": "navigation@2"
        },
        {
          "command": "tsImpact.showLastResults",
          "when": "view == tsImpact.results",
          "group": "navigation@3"
        },
        {
          "command": "tsImpact.clear",
          "when": "view == tsImpact.results",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "tsImpact.runTest",
          "when": "view == tsImpact.results && viewItem =~ /^(test|file)$/",
          "group": "inline"
        }
      ]
    },
    "views": {
      "test": [
        {
          "id": "tsImpact.results",
          "name": "Impacted Tests"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tsImpact.results",
        "contents": "Place the cursor on a function, class, method or symbol and run the analysis.\n[Test Impact Analysis](command:tsImpact.analyze)"
      }
    ],
    "taskDefinitions": [
      {
        "type": "tsImpact",
        "properties": {
          "framework": {
            "type": "string",
            "description": "Test framework used to run the impacted tests."
          }
        }
      }
    ],
    "configuration": {
      "title": "TypeScript Structure",
      "properties": {
        "tsStructure.intentions.disabled": {
          "type": "array",
          "default": [],
          "description": "Intention actions to hide from the lightbulb menu.",
          "items": {
            "type": "string",
            "enum": [
              "invertIf",
              "ifToTernary",
              "ternaryToIf",
              "flipTernary",
              "mergeNestedIfs",
              "splitAndCondition",
              "ifChainToSwitch",
              "deMorgan",
              "flipComparison",
              "concatToTemplate",
              "forIndexToForOf",
              "forEachToForOf",
              "arrowToBlockBody",
              "arrowToExpressionBody",
              "functionToArrow",
              "addBraces",
              "removeBraces",
              "splitDeclarations",
              "splitInitializer"
            ]
          }
        },
        "tsStructure.previewRefactorings": {
          "type": "boolean",
          "default": true,
          "description": "Show VS Code's Refactor Preview before applying refactorings, so individual changes can be reviewed and unticked."
        },
        "tsImpact.maxDepth": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "description": "Maximum number of caller hops followed from the selected symbol."
        },
        "tsImpact.includeInheritedMembers": {
          "type": "boolean",
          "default": true,
          "description": "Also follow calls made through interfaces and base classes that a selected class member implements or overrides. These matches are reported as possible impacts."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "test:integration": "npm run compile && node scripts/integration.js",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.1.0"
  }
}
