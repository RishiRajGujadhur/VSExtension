        "title": "Explain Finding",
        "category": "TypeScript Structure"
      },
      {
        "command": "tsStructure.report.compareDuplicates",
        "title": "Compare Copies",
        "category": "TypeScript Structure",
        "icon": "$(diff)"
      },
      {
        "command": "tsStructure.report.follow",
        "title": "Follow Into Call",
        "category": "TypeScript Structure",
        "icon": "$(arrow-small-right)"
      },
      {
        "command": "tsStructure.actionsAtCursor",
        "title": "Analyze or Refactor This…",
        "category": "TypeScript Structure"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tsStructure",
          "title": "TypeScript Structure",
          "icon": "media/structure.svg"
        }
      ]
    },
    "submenus": [
      {
        "id": "tsStructure.editorMenu",
        "label": "TypeScript Structure"
      }
    ],
    "keybindings": [
      {
        "command": "tsStructure.changeSignature",
        "key": "ctrl+f6",
        "mac": "cmd+f6",
        "when": "editorTextFocus && editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact)$/"
      },
      {
        "command": "tsStructure.introduceParameter",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact)$/"
      },
      {
        "command": "tsStructure.safeDelete",
        "key": "alt+delete",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact)$/"
      },
      {
        "command": "tsStructure.semanticUsages",
        "key": "alt+f7",
        "when": "editorTextFocus && editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact)$/"
      },
      {
        "command": "tsStructure.actionsAtCursor",
        "key": "ctrl+alt+shift+t",
        "mac": "cmd+alt+shift+t",
        "when": "editorTextFocus && editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact)$/"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "tsStructure.editorMenu",
          "when": "editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact)$/",
          "group": "1_modification@90"
        }
      ],
      "tsStructure.editorMenu": [
        {
          "command": "tsStructure.actionsAtCursor",
          "group": "0_all@1"
        },
        {
          "command": "tsStructure.changeSignature",
          "group": "1_refactor@1"
        },
        {
          "command": "tsStructure.safeDelete",
          "group": "1_refactor@2"
        },
        {
          "command": "tsStructure.introduceParameter",
          "group": "1_refactor@3"
        },
        {
          "command": "tsStructure.moveMembers",
          "group": "1_refactor@4"
        },
        {
          "command": "tsImpact.analyze",
          "group": "3_analysis@1"
        },
        {
          "command": "tsStructure.dataFlow",
          "group": "3_analysis@2"
        },
        {
          "command": "tsStructure.mutationTracking",
          "group": "3_analysis@3"
        },
        {
          "command": "tsStructure.mutationTrackingProject",
          "group": "3_analysis@3"
        },
        {
          "command": "tsStructure.sideEffects",
          "group": "3_analysis@4"
        },
        {
          "command": "tsStructure.nullability",
          "group": "3_analysis@5"
        },
        {
          "command": "tsStructure.promiseRejections",
          "group": "3_analysis@6"
        },
        {
          "command": "tsStructure.deadExports",
          "group": "3_analysis@7"
        },
        {
          "command": "tsStructure.exceptionFlow",
          "group": "3_analysis@8"
        },
        {
          "command": "tsStructure.findDuplicates",
          "group": "3_analysis@9"
        },
        {
          "command": "tsStructure.semanticUsages",
          "group": "4_navigate@1"
        },
        {
          "command": "tsStructure.reexportChain",
          "group": "4_navigate@2"
        },
        {
          "command": "tsStructure.structuralSearch",
          "group": "4_navigate@3"
        },
        {
          "command": "tsStructure.typeHierarchy",
          "group": "4_navigate@4"
        },
        {
          "command": "tsStructure.overrideImpact",
          "group": "4_navigate@5"
        },
        {
          "command": "tsStructure.dependencyPath",
          "group": "4_navigate@6"
        },
        {
          "command": "tsStructure.dependencyGraphDiff",
          "group": "4_navigate@7"
        },
        {
          "command": "tsStructure.argumentFlow",
          "group": "4_navigate@8"
        },
        {
          "command": "tsStructure.inspectCode",
          "group": "2_inspect@1"
        }
      ],
      "explorer/context": [
        {
          "command": "tsStructure.safeDeleteFile",
          "when": "resourceExtname =~ /^\\.[cm]?[jt]sx?$/",
          "group": "7_modification@90"
        },
        {
          "command": "tsStructure.dependencyPath",
          "when": "resourceExtname =~ /^\\.[cm]?[jt]sx?$/",
          "group": "7_modification@91"
        }
      ],
      "commandPalette": [
        {
          "command": "tsImpact.runTest",
          "when": "false"
        },
        {
          "command": "tsStructure.openLocation",
          "when": "false"
        },
        {
          "command": "tsStructure.rerunAnalysis",
          "when": "tsStructure.hasReport"
        },
        {
          "command": "tsStructure.report.safeDelete",
          "when": "false"
        },
        {
          "command": "tsStructure.report.unexport",
          "when": "false"
        },
        {
          "command": "tsStructure.report.safeDeleteFile",
          "when": "false"
        },
        {
          "command": "tsStructure.report.openToSide",
          "when": "false"
        },
        {
          "command": "tsStructure.report.copyLocation",
          "when": "false"
        },
        {
          "command": "tsStructure.report.back",
          "when": "tsStructure.hasReport"
        },
        {
          "command": "tsStructure.report.forward",
          "when": "tsStructure.hasReport"
        },
        {
          "command": "tsStructure.report.filter",
          "when": "tsStructure.hasReport"
        },
        {
          "command": "tsStructure.report.next",
          "when": "tsStructure.hasReport"
        },
        {
          "command": "tsStructure.report.previous",
          "when": "tsStructure.hasReport"
        },
        {
          "command": "tsStructure.report.copyMarkdown",
          "when": "tsStructure.hasReport"
        },
        {
          "command": "tsStructure.report.export",
          "when": "tsStructure.hasReport"
        },
        {
          "command": "tsStructure.report.applyFix",
          "when": "false"
        },
        {
          "command": "tsStructure.explainFinding",
          "when": "false"
        },
        {
          "command": "tsStructure.report.compareDuplicates",
          "when": "false"
        },
        {
          "command": "tsStructure.report.follow",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "tsImpact.analyze",
          "when": "view == tsImpact.results",
          "group": "navigation@1"
        },
        {
          "command": "tsImpact.runImpactedTests",
          "when": "view == tsImpact.results",
          "group": "navigation@2"
        },
        {
          "command": "tsImpact.showLastResults",
          "when": "view == tsImpact.results",
          "group": "navigation@3"
        },
        {
          "command": "tsImpact.clear",
          "when": "view == tsImpact.results",
          "group": "navigation@4"
        },
        {
          "command": "tsStructure.rerunAnalysis",
          "when": "view == tsStructure.report && tsStructure.hasReport",
          "group": "navigation@1"
        },
        {
          "command": "tsStructure.clearReport",
          "when": "view == tsStructure.report && tsStructure.hasReport",
          "group": "navigation@9"
        },
        {
          "command": "tsStructure.report.back",
          "when": "view == tsStructure.report && tsStructure.canGoBack",
          "group": "navigation@0"
        },
        {
          "command": "tsStructure.report.forward",
          "when": "view == tsStructure.report && tsStructure.canGoForward",
          "group": "navigation@0"
        },
        {
          "command": "tsStructure.report.filter",
          "when": "view == tsStructure.report && tsStructure.hasReport",
          "group": "navigation@2"
        },
        {
          "command": "tsStructure.report.previous",
          "when": "view == tsStructure.report && tsStructure.hasReport",
          "group": "navigation@3"
        },
        {
          "command": "tsStructure.report.next",
          "when": "view == tsStructure.report && tsStructure.hasReport",
          "group": "navigation@4"
        },
        {
          "command": "tsStructure.report.copyMarkdown",
          "when": "view == tsStructure.report && tsStructure.hasReport",
          "group": "1_export@1"
        },
        {
          "command": "tsStructure.report.export",
          "when": "view == tsStructure.report && tsStructure.hasReport",
          "group": "1_export@2"
        }
      ],
      "view/item/context": [
        {
          "command": "tsImpact.runTest",
          "when": "view == tsImpact.results && viewItem =~ /^(test|file)$/",
          "group": "inline"
        },
        {
          "command": "tsStructure.report.safeDelete",
          "group": "inline@1",
          "when": "view == tsStructure.report && viewItem =~ /action:deadExport/"
        },
        {
          "command": "tsStructure.report.unexport",
          "group": "inline@1",
          "when": "view == tsStructure.report && viewItem =~ /action:unexport/"
        },
        {
          "command": "tsStructure.report.safeDeleteFile",
          "group": "inline@1",
          "when": "view == tsStructure.report && viewItem =~ /action:deadFile/"
        },
        {
          "command": "tsStructure.report.openToSide",
          "when": "view == tsStructure.report && viewItem =~ /location/",
          "group": "navigation@1"
        },
        {
          "command": "tsStructure.report.copyLocation",
          "when": "view == tsStructure.report && viewItem =~ /location/",
          "group": "navigation@2"
        },
        {
          "command": "tsStructure.report.applyFix",
          "when": "view == tsStructure.report && viewItem =~ /action:applyFix/",
          "group": "inline@1"
        },
        {
          "command": "tsStructure.report.compareDuplicates",
          "when": "view == tsStructure.report && viewItem =~ /action:compareDuplicates/",
          "group": "inline@1"
        },
        {
          "command": "tsStructure.report.follow",
          "when": "view == tsStructure.report && viewItem =~ /action:follow/",
          "group": "inline@1"
        }
      ]
    },
    "views": {
      "tsStructure": [
        {
          "id": "tsStructure.report",
          "name": "Analysis"
        }
      ],
      "test": [
        {
          "id": "tsImpact.results",
          "name": "Impacted Tests"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tsStructure.report",
        "contents": "Inspections and navigation results appear here. Place the cursor on a symbol and run one of the analyses from the editor's context menu under TypeScript Structure.\n[Data Flow Path Explorer](command:tsStructure.dataFlow)"
      },
      {
        "view": "tsImpact.results",
        "contents": "Place the cursor on a function, class, method or symbol and run the analysis.\n[Test Impact Analysis](command:tsImpact.analyze)"
      }
    ],
    "taskDefinitions": [
      {
        "type": "tsImpact",
        "properties": {
          "framework": {
            "type": "string",
            "description": "Test framework used to run the impacted tests."
          }
        }
      }
    ],
    "configuration": {
      "title": "TypeScript Structure",
      "properties": {
        "tsStructure.intentions.disabled": {
          "type": "array",
          "default": [],
          "description": "Intention actions to hide from the lightbulb menu.",
          "items": {
            "type": "string",
            "enum": [
              "invertIf",
              "ifToTernary",
              "ternaryToIf",
              "flipTernary",
              "mergeNestedIfs",
              "splitAndCondition",
              "ifChainToSwitch",
              "deMorgan",
              "flipComparison",
              "concatToTemplate",
              "forIndexToForOf",
              "forEachToForOf",
              "arrowToBlockBody",
              "arrowToExpressionBody",
              "functionToArrow",
              "addBraces",
              "removeBraces",
              "splitDeclarations",
              "splitInitializer"
            ]
          }
        },
        "tsStructure.previewRefactorings": {
          "type": "boolean",
          "default": true,
          "description": "Show VS Code's Refactor Preview before applying refactorings, so individual changes can be reviewed and unticked."
        },
        "tsImpact.maxDepth": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "description": "Maximum number of caller hops followed from the selected symbol."
        },
        "tsImpact.includeInheritedMembers": {
          "type": "boolean",
          "default": true,
          "description": "Also follow calls made through interfaces and base classes that a selected class member implements or overrides. These matches are reported as possible impacts."
        },
        "tsStructure.inspections.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run the TypeScript Structure inspections on open files and report findings in the Problems panel."
        },
        "tsStructure.inspections.severity": {
          "type": "object",
          "default": {},
          "markdownDescription": "Severity per inspection, or `off` to disable it. `default` keeps the severity each finding is reported with. Findings can also be suppressed in code with `// ts-structure-ignore-next-line <id>` or `// ts-structure-ignore-file <id>`. Add `\"editor.codeActionsOnSave\": { \"source.fixAll.tsStructure\": \"explicit\" }` to apply preferred fixes on save.",
          "properties": {
            "missingAwait": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "error",
                "warning",
                "info",
                "hint"
              ],
              "default": "default",
              "description": "Promises that are dropped, including through wrapper functions and helpers."
            },
            "typeAssertion": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "error",
                "warning",
                "info",
                "hint"
              ],
              "default": "default",
              "description": "Type assertions that are unnecessary, widen silently, narrow without a runtime check, or bypass compatibility checks."
            }
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "default",
              "off",
              "error",
              "warning",
              "info",
              "hint"
            ],
            "default": "default"
          }
        },
        "tsStructure.deadExports.entryPoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Glob patterns, relative to the workspace folder, for the files whose exports are the public API (for example `src/index.ts` or `src/pages/**`). When empty, entry points are read from package.json (`main`, `module`, `exports`, `bin`) and conventional `index`/`main` files."
        },
        "tsStructure.deadExports.testFilesAreEntryPoints": {
          "type": "boolean",
          "default": true,
          "description": "Treat test files as entry points, so exports used only by tests are not reported as dead."
        },
        "tsStructure.duplicates.minStatements": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "Shortest run of consecutive statements compared by the structural duplicate finder."
        },
        "tsStructure.duplicates.minTokens": {
          "type": "number",
          "default": 40,
          "minimum": 5,
          "description": "Smallest duplicated fragment, in syntax nodes, that is reported."
        },
        "tsStructure.duplicates.ignoreTestFiles": {
          "type": "boolean",
          "default": true,
          "description": "Leave test files out of project-wide duplicate searches."
        },
        "tsStructure.customInspections": {
          "type": "array",
          "default": [],
          "markdownDescription": "Structural search patterns that run as live inspections. Create them with **Structural Search… → Save as Inspection** and manage them with **Manage Custom Inspections…**.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "pattern",
              "message"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique id, shown as the diagnostic code custom:<id>."
              },
              "pattern": {
                "type": "string",
                "description": "Structural search pattern with $name$ placeholders."
              },
              "constraints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "description": "Regular expression tested against the matched type."
                    },
                    "text": {
                      "type": "string",
                      "description": "Regular expression tested against the matched text."
                    },
                    "negate": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "message": {
                "type": "string",
                "description": "Message for each match; $name$ is filled in from the match."
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning",
                  "info",
                  "hint"
                ],
                "default": "warning"
              },
              "replacement": {
                "type": "string",
                "description": "Quick fix template using the pattern placeholders."
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "files": {
                "type": "string",
                "description": "Regular expression tested against file paths; only matching files are inspected."
              }
            }
          }
        },
        "tsStructure.argumentFlow.maxDepth": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 20,
          "description": "How many calls the Argument Propagation Explorer follows in each direction."
        },
        "tsStructure.highlightResults": {
          "type": "boolean",
          "default": true,
          "description": "Highlight the locations of the current analysis in open editors: definitions outlined, writes and reads shaded."
        },
        "tsStructure.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Glob patterns, relative to the workspace folder, for files left out of inspections, Inspect Code, structural search, duplicate detection and dead export results (for example `**/generated/**` or `src/legacy/*.ts`)."
        },
        "tsStructure.inspections.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the number of inspection findings in the active file in the status bar."
        },
        "tsStructure.codeLens.sideEffects": {
          "type": "boolean",
          "default": false,
          "description": "Show a CodeLens above each function summarizing its side effects (\"pure\", \"mutates arguments · I/O\", …). Click it for the full Side-Effect Analyzer report."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "test:integration": "npm run compile && node scripts/integration.js",
    "screenshots": "npm run compile && node scripts/screenshots.js",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.1.0"
  }
}
