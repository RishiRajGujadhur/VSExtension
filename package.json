{
  "name": "ts-test-impact",
  "displayName": "TypeScript Structure: Refactoring & Test Impact",
  "description": "WebStorm-style refactorings for TypeScript and JavaScript (Change Signature, Safe Delete, Introduce Parameter, Move Members and intention actions) plus test impact analysis. Deterministic, offline, no AI.",
  "version": "0.6.0",
  "publisher": "RishiRajGujadhur",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RishiRajGujadhur/VSExtension.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "refactoring",
    "change signature",
    "typescript",
    "react",
    "webstorm",
    "test impact"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tsImpact.analyze",
        "title": "Test Impact Analysis",
        "category": "TypeScript Structure",
        "icon": "$(search)"
      },
      {
        "command": "tsImpact.showLastResults",
        "title": "Show Last Impact Results",
        "category": "TypeScript Structure",
        "icon": "$(list-filter)"
      },
      {
        "command": "tsImpact.runImpactedTests",
        "title": "Run Impacted Tests",
        "category": "TypeScript Structure",
        "icon": "$(play)"
      },
      {
        "command": "tsImpact.runTest",
        "title": "Run Test",
        "category": "TypeScript Structure",
        "icon": "$(play)"
      },
      {
        "command": "tsImpact.clear",
        "title": "Clear Impact Results",
        "category": "TypeScript Structure",
        "icon": "$(clear-all)"
      },
      {
        "command": "tsStructure.changeSignature",
        "title": "Change Signature…",
        "category": "TypeScript Structure"
      },
      {
        "command": "tsStructure.safeDelete",
        "title": "Safe Delete…",
        "category": "TypeScript Structure"
      },
      {
        "command": "tsStructure.safeDeleteFile",
        "title": "Safe Delete File…",
        "category": "TypeScript Structure"
      },
      {
        "command": "tsStructure.introduceParameter",
        "title": "Introduce Parameter…",
        "category": "TypeScript Structure"
      },
      {
        "command": "tsStructure.moveMembers",
        "title": "Move Members to Module…",
        "category": "TypeScript Structure"
      },
      {
        "command": "tsStructure.openLocation",
        "title": "Open Location",
        "category": "TypeScript Structure"
      },
      {
        "command": "tsStructure.rerunAnalysis",
        "title": "Re-run Analysis",
        "category": "TypeScript Structure",
        "icon": "$(refresh)"
      },
      {
        "command": "tsStructure.clearReport",
        "title": "Clear Analysis",
        "category": "TypeScript Structure",
        "icon": "$(clear-all)"
      },
      {
        "command": "tsStructure.dataFlow",
        "title": "Data Flow Path Explorer",
        "category": "TypeScript Structure"
      },
      {
        "command": "tsStructure.mutationTracking",
        "title": "Mutation Tracking (Active File)",
        "category": "TypeScript Structure"
      },
      {
        "command": "tsStructure.sideEffects",
        "title": "Side-Effect Analyzer",
        "category": "TypeScript Structure"
      },
      {
        "command": "tsStructure.nullability",
        "title": "Nullability Path Explorer",
        "category": "TypeScript Structure"
      },
      {
        "command": "tsStructure.promiseRejections",
        "title": "Promise Rejection Analyzer",
        "category": "TypeScript Structure"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tsStructure",
          "title": "TypeScript Structure",
          "icon": "media/structure.svg"
        }
      ]
    },
    "submenus": [
      {
        "id": "tsStructure.editorMenu",
        "label": "TypeScript Structure"
      }
    ],
    "keybindings": [
      {
        "command": "tsStructure.changeSignature",
        "key": "ctrl+f6",
        "mac": "cmd+f6",
        "when": "editorTextFocus && editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact)$/"
      },
      {
        "command": "tsStructure.introduceParameter",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact)$/"
      },
      {
        "command": "tsStructure.safeDelete",
        "key": "alt+delete",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact)$/"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "tsStructure.editorMenu",
          "when": "editorLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact)$/",
          "group": "1_modification@90"
        }
      ],
      "tsStructure.editorMenu": [
        {
          "command": "tsStructure.changeSignature",
          "group": "1_refactor@1"
        },
        {
          "command": "tsStructure.safeDelete",
          "group": "1_refactor@2"
        },
        {
          "command": "tsStructure.introduceParameter",
          "group": "1_refactor@3"
        },
        {
          "command": "tsStructure.moveMembers",
          "group": "1_refactor@4"
        },
        {
          "command": "tsImpact.analyze",
          "group": "3_analysis@1"
        },
        {
          "command": "tsStructure.dataFlow",
          "group": "3_analysis@2"
        },
        {
          "command": "tsStructure.mutationTracking",
          "group": "3_analysis@3"
        },
        {
          "command": "tsStructure.sideEffects",
          "group": "3_analysis@4"
        },
        {
          "command": "tsStructure.nullability",
          "group": "3_analysis@5"
        },
        {
          "command": "tsStructure.promiseRejections",
          "group": "3_analysis@6"
        }
      ],
      "explorer/context": [
        {
          "command": "tsStructure.safeDeleteFile",
          "when": "resourceExtname =~ /^\\.[cm]?[jt]sx?$/",
          "group": "7_modification@90"
        }
      ],
      "commandPalette": [
        {
          "command": "tsImpact.runTest",
          "when": "false"
        },
        {
          "command": "tsStructure.openLocation",
          "when": "false"
        },
        {
          "command": "tsStructure.rerunAnalysis",
          "when": "tsStructure.hasReport"
        }
      ],
      "view/title": [
        {
          "command": "tsImpact.analyze",
          "when": "view == tsImpact.results",
          "group": "navigation@1"
        },
        {
          "command": "tsImpact.runImpactedTests",
          "when": "view == tsImpact.results",
          "group": "navigation@2"
        },
        {
          "command": "tsImpact.showLastResults",
          "when": "view == tsImpact.results",
          "group": "navigation@3"
        },
        {
          "command": "tsImpact.clear",
          "when": "view == tsImpact.results",
          "group": "navigation@4"
        },
        {
          "command": "tsStructure.rerunAnalysis",
          "when": "view == tsStructure.report && tsStructure.hasReport",
          "group": "navigation@1"
        },
        {
          "command": "tsStructure.clearReport",
          "when": "view == tsStructure.report && tsStructure.hasReport",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "tsImpact.runTest",
          "when": "view == tsImpact.results && viewItem =~ /^(test|file)$/",
          "group": "inline"
        }
      ]
    },
    "views": {
      "tsStructure": [
        {
          "id": "tsStructure.report",
          "name": "Analysis"
        }
      ],
      "test": [
        {
          "id": "tsImpact.results",
          "name": "Impacted Tests"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tsStructure.report",
        "contents": "Inspections and navigation results appear here. Place the cursor on a symbol and run one of the analyses from the editor's context menu under TypeScript Structure.\n[Data Flow Path Explorer](command:tsStructure.dataFlow)"
      },
      {
        "view": "tsImpact.results",
        "contents": "Place the cursor on a function, class, method or symbol and run the analysis.\n[Test Impact Analysis](command:tsImpact.analyze)"
      }
    ],
    "taskDefinitions": [
      {
        "type": "tsImpact",
        "properties": {
          "framework": {
            "type": "string",
            "description": "Test framework used to run the impacted tests."
          }
        }
      }
    ],
    "configuration": {
      "title": "TypeScript Structure",
      "properties": {
        "tsStructure.intentions.disabled": {
          "type": "array",
          "default": [],
          "description": "Intention actions to hide from the lightbulb menu.",
          "items": {
            "type": "string",
            "enum": [
              "invertIf",
              "ifToTernary",
              "ternaryToIf",
              "flipTernary",
              "mergeNestedIfs",
              "splitAndCondition",
              "ifChainToSwitch",
              "deMorgan",
              "flipComparison",
              "concatToTemplate",
              "forIndexToForOf",
              "forEachToForOf",
              "arrowToBlockBody",
              "arrowToExpressionBody",
              "functionToArrow",
              "addBraces",
              "removeBraces",
              "splitDeclarations",
              "splitInitializer"
            ]
          }
        },
        "tsStructure.previewRefactorings": {
          "type": "boolean",
          "default": true,
          "description": "Show VS Code's Refactor Preview before applying refactorings, so individual changes can be reviewed and unticked."
        },
        "tsImpact.maxDepth": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "description": "Maximum number of caller hops followed from the selected symbol."
        },
        "tsImpact.includeInheritedMembers": {
          "type": "boolean",
          "default": true,
          "description": "Also follow calls made through interfaces and base classes that a selected class member implements or overrides. These matches are reported as possible impacts."
        },
        "tsStructure.inspections.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run the TypeScript Structure inspections on open files and report findings in the Problems panel."
        },
        "tsStructure.inspections.severity": {
          "type": "object",
          "default": {},
          "markdownDescription": "Severity per inspection, or `off` to disable it. `default` keeps the severity each finding is reported with. Findings can also be suppressed in code with `// ts-structure-ignore-next-line <id>` or `// ts-structure-ignore-file <id>`.",
          "properties": {
            "missingAwait": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "error",
                "warning",
                "info",
                "hint"
              ],
              "default": "default",
              "description": "Promises that are dropped, including through wrapper functions and helpers."
            },
            "typeAssertion": {
              "type": "string",
              "enum": [
                "default",
                "off",
                "error",
                "warning",
                "info",
                "hint"
              ],
              "default": "default",
              "description": "Type assertions that are unnecessary, widen silently, narrow without a runtime check, or bypass compatibility checks."
            }
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "default",
              "off",
              "error",
              "warning",
              "info",
              "hint"
            ],
            "default": "default"
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "test:integration": "npm run compile && node scripts/integration.js",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.1.0"
  }
}
