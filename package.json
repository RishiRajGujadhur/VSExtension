{
  "name": "ts-test-impact",
  "displayName": "TypeScript Structure: Refactoring & Test Impact",
  "description": "WebStorm-style refactorings, cross-file inspections, structural search and navigation for TypeScript, JavaScript and React, plus test impact analysis. Deterministic, offline, no AI.",
  "version": "0.7.0",
  "publisher": "RishiRajGujadhur",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RishiRajGujadhur/VSExtension.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "refactoring",
    "change signature",
    "typescript",
    "react",
    "webstorm",
    "test impact",
    "inspections",
    "structural search",
    "data flow",
    "dead code",
    "dependency graph"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tsImpact.analyze",
        "title": "Test Impact Analysis",
        "category": "TypeScript Structure",
        "icon": "$(search)"
      },
      {
        "command": "tsImpact.showLastResults",
        "title": "Show Last Impact Results",
        "category": "TypeScript Structure",
        "icon": "$(list-filter)"
      },
      {
        "command": "tsImpact.runImpactedTests",
        "title": "Run Impacted Tests",
        "category": "TypeScript Structure",
        "icon": "$(play)"
      },
      {
        "command": "tsImpact.runTest",
        "title": "Run Test",
        "category": "TypeScript Structure",
        "icon": "$(play)"
      },
      {
        "command": "tsImpact.clear",
        "title": "Clear Impact Results",
        "category": "TypeScript Structure",
